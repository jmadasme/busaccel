[79.988, "o", "\u001b[90m┌─ processSample: desviación y símbolo ─────────────────────────────────────────────────────────────────\u001b[0m\n"]
[79.988, "o", "\u001b[90m 498\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00m\u001b[90m// La desviacion que decide es SOLO la de Z (gx, gy y spX/spY se siguen\u001b[39;49;00m\n"]
[80.043, "o", "\u001b[90m 499\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00m\u001b[90m// calculando para la linea CSV y para el setpoint, pero no disparan evento).\u001b[39;49;00m\n"]
[80.098, "o", "\u001b[90m 500\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00mdevZ\u001b[90m        \u001b[39;49;00m=\u001b[90m \u001b[39;49;00mgz\u001b[90m \u001b[39;49;00m-\u001b[90m \u001b[39;49;00mspZ;\u001b[90m\u001b[39;49;00m\n"]
[80.153, "o", "\u001b[90m 501\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00m\u001b[96mbool\u001b[39;49;00m\u001b[90m \u001b[39;49;00meventActive\u001b[90m \u001b[39;49;00m=\u001b[90m \u001b[39;49;00mfabsf(devZ)\u001b[90m \u001b[39;49;00m>\u001b[90m \u001b[39;49;00mARROW_THRESHOLD_G;\u001b[90m\u001b[39;49;00m\n"]
[80.208, "o", "\u001b[90m 502\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00m\u001b[96mbool\u001b[39;49;00m\u001b[90m \u001b[39;49;00mallResting\u001b[90m  \u001b[39;49;00m=\u001b[90m \u001b[39;49;00m(fabsf(devZ)\u001b[90m \u001b[39;49;00m<=\u001b[90m \u001b[39;49;00mRETURN_G);\u001b[90m\u001b[39;49;00m\n"]
[80.263, "o", "\u001b[90m 503\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[80.318, "o", "\u001b[90m 504\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00m\u001b[94mswitch\u001b[39;49;00m\u001b[90m \u001b[39;49;00m(detectState)\u001b[90m \u001b[39;49;00m{\u001b[90m\u001b[39;49;00m\n"]
[80.373, "o", "\u001b[90m 505\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[80.428, "o", "\u001b[90m 506\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00m\u001b[94mcase\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[91mST_IDLE\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[80.483, "o", "\u001b[90m 507\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m      \u001b[39;49;00m\u001b[94mif\u001b[39;49;00m\u001b[90m \u001b[39;49;00m(eventActive)\u001b[90m \u001b[39;49;00m{\u001b[90m\u001b[39;49;00m\n"]
[80.538, "o", "\u001b[90m 508\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m        \u001b[39;49;00m\u001b[90m// Sentido y magnitud de la desviacion de Z respecto del setpoint:\u001b[39;49;00m\n"]
[80.593, "o", "\u001b[90m 509\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m        \u001b[39;49;00m\u001b[90m//   devZ >=  +SEVERE  -> '*'   elevacion severa\u001b[39;49;00m\n"]
[80.648, "o", "\u001b[90m 510\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m        \u001b[39;49;00m\u001b[90m//   devZ >   +ARROW   -> '+'   elevacion leve\u001b[39;49;00m\n"]
[80.703, "o", "\u001b[90m 511\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m        \u001b[39;49;00m\u001b[90m//   devZ <= -SEVERE   -> '!'   caida severa\u001b[39;49;00m\n"]
[80.758, "o", "\u001b[90m 512\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m        \u001b[39;49;00m\u001b[90m//   devZ <   -ARROW   -> '-'   caida leve\u001b[39;49;00m\n"]
[80.813, "o", "\u001b[90m 513\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m        \u001b[39;49;00meventChar\u001b[90m \u001b[39;49;00m=\u001b[90m \u001b[39;49;00m(devZ\u001b[90m \u001b[39;49;00m>=\u001b[90m  \u001b[39;49;00mSEVERE_THRESHOLD_G)\u001b[90m \u001b[39;49;00m?\u001b[90m \u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33m*\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[80.868, "o", "\u001b[90m 514\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m                  \u001b[39;49;00m:\u001b[90m \u001b[39;49;00m(devZ\u001b[90m \u001b[39;49;00m>\u001b[90m   \u001b[39;49;00mARROW_THRESHOLD_G)\u001b[90m  \u001b[39;49;00m?\u001b[90m \u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33m+\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[80.923, "o", "\u001b[90m 515\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m                  \u001b[39;49;00m:\u001b[90m \u001b[39;49;00m(devZ\u001b[90m \u001b[39;49;00m<=\u001b[90m \u001b[39;49;00m-SEVERE_THRESHOLD_G)\u001b[90m \u001b[39;49;00m?\u001b[90m \u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33m!\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[80.978, "o", "\u001b[90m 516\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m                  \u001b[39;49;00m:\u001b[90m                                \u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33m-\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m;\u001b[90m\u001b[39;49;00m\n"]
[81.033, "o", "\u001b[90m 517\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m        \u001b[39;49;00msymbolPending\u001b[90m \u001b[39;49;00m=\u001b[90m \u001b[39;49;00m\u001b[96mtrue\u001b[39;49;00m;\u001b[90m\u001b[39;49;00m\n"]
[81.088, "o", "\u001b[90m 518\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m        \u001b[39;49;00mdetectState\u001b[90m \u001b[39;49;00m=\u001b[90m \u001b[39;49;00mST_LOCKED;\u001b[90m\u001b[39;49;00m\n"]
[81.143, "o", "\u001b[90m 519\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m        \u001b[39;49;00mlockUntilMs\u001b[90m \u001b[39;49;00m=\u001b[90m \u001b[39;49;00mmillis()\u001b[90m \u001b[39;49;00m+\u001b[90m \u001b[39;49;00mEVENT_LOCKOUT_MS;\u001b[90m\u001b[39;49;00m\n"]
[81.198, "o", "\u001b[90m 520\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m        \u001b[39;49;00mrestSinceMs\u001b[90m \u001b[39;49;00m=\u001b[90m \u001b[39;49;00m\u001b[94m0\u001b[39;49;00m;\u001b[90m\u001b[39;49;00m\n"]
[81.253, "o", "\u001b[90m 521\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m        \u001b[39;49;00mbeginCapture();\u001b[90m          \u001b[39;49;00m\u001b[90m// arranca la ventana del evento\u001b[39;49;00m\n"]
[81.308, "o", "\u001b[90m 522\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m      \u001b[39;49;00m}\u001b[90m \u001b[39;49;00m\u001b[94melse\u001b[39;49;00m\u001b[90m \u001b[39;49;00m{\u001b[90m\u001b[39;49;00m\n"]
