[25.377, "o", "\u001b[90m┌─ Constantes de muestreo y detección ──────────────────────────────────────────────────────────────────\u001b[0m\n"]
[25.377, "o", "\u001b[90m  90\u001b[0m\u001b[90m │ \u001b[0m\u001b[96m#\u001b[39;49;00m\u001b[96mdefine BAUD_RATE            115200\u001b[39;49;00m\u001b[96m\u001b[39;49;00m\n"]
[25.432, "o", "\u001b[90m  91\u001b[0m\u001b[90m │ \u001b[0m\u001b[96m#\u001b[39;49;00m\u001b[96mdefine FW_VERSION          \"4\"\u001b[39;49;00m\u001b[96m\u001b[39;49;00m\n"]
[25.487, "o", "\u001b[90m  92\u001b[0m\u001b[90m │ \u001b[0m\u001b[96m#\u001b[39;49;00m\u001b[96mdefine FW_BUILD            \"2026-10-08\"\u001b[39;49;00m\u001b[96m\u001b[39;49;00m\n"]
[25.542, "o", "\u001b[90m  93\u001b[0m\u001b[90m │ \u001b[0m\u001b[96m#\u001b[39;49;00m\u001b[96mdefine SENSOR_RANGE         ADXL345_RANGE_2_G\u001b[39;49;00m\u001b[96m\u001b[39;49;00m\n"]
[25.597, "o", "\u001b[90m  94\u001b[0m\u001b[90m │ \u001b[0m\u001b[96m#\u001b[39;49;00m\u001b[96mdefine SENSOR_DATARATE      ADXL345_DATARATE_100_HZ\u001b[39;49;00m\u001b[96m\u001b[39;49;00m\n"]
[25.652, "o", "\u001b[90m  95\u001b[0m\u001b[90m │ \u001b[0m\u001b[96m#\u001b[39;49;00m\u001b[96mdefine SAMPLE_INTERVAL_MS   10        \u001b[39;49;00m\u001b[90m// muestreo interno ~100 Hz\u001b[39;49;00m\n"]
[25.707, "o", "\u001b[90m  96\u001b[0m\u001b[90m │ \u001b[0m\u001b[96m#\u001b[39;49;00m\u001b[96mdefine PRINT_INTERVAL_MS    50        \u001b[39;49;00m\u001b[90m// impresion serial ~20 Hz (modo serie puro)\u001b[39;49;00m\n"]
[25.762, "o", "\u001b[90m  97\u001b[0m\u001b[90m │ \u001b[0m\u001b[96m#\u001b[39;49;00m\u001b[96mdefine SENSOR_RETRY_MS      1000      \u001b[39;49;00m\u001b[90m// reintento en background cada 1 s\u001b[39;49;00m\n"]
[25.817, "o", "\u001b[90m  98\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[25.872, "o", "\u001b[90m  99\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m// Setpoint\u001b[39;49;00m\n"]
[25.927, "o", "\u001b[90m 100\u001b[0m\u001b[90m │ \u001b[0m\u001b[96m#\u001b[39;49;00m\u001b[96mdefine SETPOINT_N           20            \u001b[39;49;00m\u001b[90m// lecturas para el promedio por eje\u001b[39;49;00m\n"]
[25.982, "o", "\u001b[90m 101\u001b[0m\u001b[90m │ \u001b[0m\u001b[96m#\u001b[39;49;00m\u001b[96mdefine ARROW_THRESHOLD_G    0.20f         \u001b[39;49;00m\u001b[90m// desviacion Z (g) para '+'/'-'\u001b[39;49;00m\n"]
[26.037, "o", "\u001b[90m 102\u001b[0m\u001b[90m │ \u001b[0m\u001b[96m#\u001b[39;49;00m\u001b[96mdefine SEVERE_FACTOR        1.2f\u001b[39;49;00m\u001b[96m\u001b[39;49;00m\n"]
[26.092, "o", "\u001b[90m 103\u001b[0m\u001b[90m │ \u001b[0m\u001b[96m#\u001b[39;49;00m\u001b[96mdefine SEVERE_THRESHOLD_G   (ARROW_THRESHOLD_G * SEVERE_FACTOR)  \u001b[39;49;00m\u001b[90m// 0.24g\u001b[39;49;00m\n"]
[26.147, "o", "\u001b[90m 104\u001b[0m\u001b[90m │ \u001b[0m\u001b[96m#\u001b[39;49;00m\u001b[96mdefine RETURN_G             0.15f         \u001b[39;49;00m\u001b[90m// histeresis de retorno a reposo\u001b[39;49;00m\n"]
[26.202, "o", "\u001b[90m└───────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\n"]
[26.302, "o", "\n"]
