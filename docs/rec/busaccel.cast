[65.447, "o", "\u001b[90m┌─ pushSample y beginCapture ───────────────────────────────────────────────────────────────────────────\u001b[0m\n"]
[65.447, "o", "\u001b[90m 394\u001b[0m\u001b[90m │ \u001b[0m\u001b[96mvoid\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mpushSample\u001b[39;49;00m(\u001b[96muint16_t\u001b[39;49;00m\u001b[90m \u001b[39;49;00mdt)\u001b[90m \u001b[39;49;00m{\u001b[90m\u001b[39;49;00m\n"]
[65.502, "o", "\u001b[90m 395\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00mpreRing[ringIdx].x\u001b[90m  \u001b[39;49;00m=\u001b[90m \u001b[39;49;00mrawX;\u001b[90m\u001b[39;49;00m\n"]
[65.557, "o", "\u001b[90m 396\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00mpreRing[ringIdx].y\u001b[90m  \u001b[39;49;00m=\u001b[90m \u001b[39;49;00mrawY;\u001b[90m\u001b[39;49;00m\n"]
[65.612, "o", "\u001b[90m 397\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00mpreRing[ringIdx].z\u001b[90m  \u001b[39;49;00m=\u001b[90m \u001b[39;49;00mrawZ;\u001b[90m\u001b[39;49;00m\n"]
[65.667, "o", "\u001b[90m 398\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00mpreRing[ringIdx].dt\u001b[90m \u001b[39;49;00m=\u001b[90m \u001b[39;49;00mdt;\u001b[90m\u001b[39;49;00m\n"]
[65.722, "o", "\u001b[90m 399\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00mringIdx\u001b[90m \u001b[39;49;00m=\u001b[90m \u001b[39;49;00m(\u001b[96muint8_t\u001b[39;49;00m)((ringIdx\u001b[90m \u001b[39;49;00m+\u001b[90m \u001b[39;49;00m\u001b[94m1\u001b[39;49;00m)\u001b[90m \u001b[39;49;00m%\u001b[90m \u001b[39;49;00mPRE_N);\u001b[90m\u001b[39;49;00m\n"]
[65.777, "o", "\u001b[90m 400\u001b[0m\u001b[90m │ \u001b[0m}\u001b[90m\u001b[39;49;00m\n"]
[65.832, "o", "\u001b[90m 401\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[65.887, "o", "\u001b[90m 402\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m// ---------------------------------------------------------------------------\u001b[39;49;00m\n"]
[65.942, "o", "\u001b[90m 403\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m// Arranque de la ventana: se escanea el anillo del pasado para medir el pico\u001b[39;49;00m\n"]
[65.997, "o", "\u001b[90m 404\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m// inicial, en vez de copiarlo (no se almacena la ventana completa).\u001b[39;49;00m\n"]
[66.052, "o", "\u001b[90m 405\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m// ---------------------------------------------------------------------------\u001b[39;49;00m\n"]
[66.107, "o", "\u001b[90m 406\u001b[0m\u001b[90m │ \u001b[0m\u001b[96mvoid\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mbeginCapture\u001b[39;49;00m()\u001b[90m \u001b[39;49;00m{\u001b[90m\u001b[39;49;00m\n"]
[66.162, "o", "\u001b[90m 407\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00meventDevZ\u001b[90m  \u001b[39;49;00m=\u001b[90m \u001b[39;49;00mdevZ;\u001b[90m\u001b[39;49;00m\n"]
