[162.822, "o", "\u001b[90m┌─ loop: muestreo con prioridad ────────────────────────────────────────────────────────────────────────\u001b[0m\n"]
[162.822, "o", "\u001b[90m 849\u001b[0m\u001b[90m │ \u001b[0m\u001b[96mvoid\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mloop\u001b[39;49;00m()\u001b[90m \u001b[39;49;00m{\u001b[90m\u001b[39;49;00m\n"]
[162.877, "o", "\u001b[90m 850\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00mESP.wdtFeed();\u001b[90m\u001b[39;49;00m\n"]
[162.932, "o", "\u001b[90m 851\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00m\u001b[96munsigned\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[96mlong\u001b[39;49;00m\u001b[90m \u001b[39;49;00mnow\u001b[90m \u001b[39;49;00m=\u001b[90m \u001b[39;49;00mmillis();\u001b[90m\u001b[39;49;00m\n"]
[162.987, "o", "\u001b[90m 852\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[163.042, "o", "\u001b[90m 853\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00m\u001b[90m// =========================================================================\u001b[39;49;00m\n"]
[163.097, "o", "\u001b[90m 854\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00m\u001b[90m// 1) MUESTREO PRIMERO (~100 Hz). Tiene prioridad sobre la red: las\u001b[39;49;00m\n"]
[163.152, "o", "\u001b[90m 855\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00m\u001b[90m//    reconexiones WiFi/MQTT son no bloqueantes y no se pierden golpes.\u001b[39;49;00m\n"]
[163.207, "o", "\u001b[90m 856\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00m\u001b[90m// =========================================================================\u001b[39;49;00m\n"]
[163.262, "o", "\u001b[90m 857\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00m\u001b[90m// Muestreo interno a ~100 Hz\u001b[39;49;00m\n"]
[163.317, "o", "\u001b[90m 858\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00m\u001b[94mif\u001b[39;49;00m\u001b[90m \u001b[39;49;00m(now\u001b[90m \u001b[39;49;00m-\u001b[90m \u001b[39;49;00mlastSampleMs\u001b[90m \u001b[39;49;00m>=\u001b[90m \u001b[39;49;00mSAMPLE_INTERVAL_MS)\u001b[90m \u001b[39;49;00m{\u001b[90m\u001b[39;49;00m\n"]
[163.372, "o", "\u001b[90m 859\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00m\u001b[96muint16_t\u001b[39;49;00m\u001b[90m \u001b[39;49;00mdt\u001b[90m \u001b[39;49;00m=\u001b[90m \u001b[39;49;00m(\u001b[96muint16_t\u001b[39;49;00m)(now\u001b[90m \u001b[39;49;00m-\u001b[90m \u001b[39;49;00mlastSampleMs);\u001b[90m\u001b[39;49;00m\n"]
[163.427, "o", "\u001b[90m 860\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00mlastSampleMs\u001b[90m \u001b[39;49;00m=\u001b[90m \u001b[39;49;00mnow;\u001b[90m\u001b[39;49;00m\n"]
[163.482, "o", "\u001b[90m 861\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00m\u001b[94mif\u001b[39;49;00m\u001b[90m \u001b[39;49;00m(readAccel())\u001b[90m \u001b[39;49;00m{\u001b[90m\u001b[39;49;00m\n"]
[163.537, "o", "\u001b[90m 862\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m      \u001b[39;49;00mpushSample(dt);\u001b[90m       \u001b[39;49;00m\u001b[90m// 1) anillo del pasado (siempre, evento o no)\u001b[39;49;00m\n"]
[163.592, "o", "\u001b[90m 863\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m      \u001b[39;49;00mprocessSample();\u001b[90m      \u001b[39;49;00m\u001b[90m// 2) deteccion -> puede abrir una ventana\u001b[39;49;00m\n"]
[163.647, "o", "\u001b[90m 864\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m      \u001b[39;49;00madvanceCapture(dt);\u001b[90m   \u001b[39;49;00m\u001b[90m// 3) si hay ventana, actualiza el pico y cuenta POST\u001b[39;49;00m\n"]
[163.702, "o", "\u001b[90m 865\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00m}\u001b[90m\u001b[39;49;00m\n"]
[163.757, "o", "\u001b[90m 866\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00m}\u001b[90m\u001b[39;49;00m\n"]
