[94.226, "o", "\u001b[90m┌─ finishCapture: MQTT condicional ─────────────────────────────────────────────────────────────────────\u001b[0m\n"]
[94.226, "o", "\u001b[90m 442\u001b[0m\u001b[90m │ \u001b[0m\u001b[96mvoid\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mfinishCapture\u001b[39;49;00m()\u001b[90m \u001b[39;49;00m{\u001b[90m\u001b[39;49;00m\n"]
[94.281, "o", "\u001b[90m 443\u001b[0m\u001b[90m │ \u001b[0m\u001b[96m#\u001b[39;49;00m\u001b[96mif MODE_SERIAL_CSV == 0\u001b[39;49;00m\u001b[96m\u001b[39;49;00m\n"]
[94.336, "o", "\u001b[90m 444\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00m\u001b[90m// 1. Publicacion MQTT CONDICIONAL: solo si el pico supera el umbral.\u001b[39;49;00m\n"]
[94.391, "o", "\u001b[90m 445\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00m\u001b[94mif\u001b[39;49;00m\u001b[90m \u001b[39;49;00m(eventPeakZ\u001b[90m \u001b[39;49;00m>\u001b[90m \u001b[39;49;00mPUBLISH_MIN_PEAK_G)\u001b[90m \u001b[39;49;00m{\u001b[90m\u001b[39;49;00m\n"]
[94.446, "o", "\u001b[90m 446\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00mpublishPeakEvent();\u001b[90m\u001b[39;49;00m\n"]
[94.501, "o", "\u001b[90m 447\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00m}\u001b[90m\u001b[39;49;00m\n"]
[94.556, "o", "\u001b[90m 448\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00m\u001b[90m// 2. Salida serie: UNA sola linea, SOLO el numero del pico (%.2f).\u001b[39;49;00m\n"]
[94.611, "o", "\u001b[90m 449\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00m\u001b[90m//    Se imprime SIEMPRE (evento detectado), independiente del umbral MQTT.\u001b[39;49;00m\n"]
[94.666, "o", "\u001b[90m 450\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00mSerial.printf(\u001b[33m\"\u001b[39;49;00m\u001b[33m%.2f\u001b[39;49;00m\u001b[33m\\n\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m,\u001b[90m \u001b[39;49;00meventPeakZ);\u001b[90m\u001b[39;49;00m\n"]
[94.721, "o", "\u001b[90m 451\u001b[0m\u001b[90m │ \u001b[0m\u001b[96m#\u001b[39;49;00m\u001b[96mendif\u001b[39;49;00m\u001b[96m\u001b[39;49;00m\n"]
[94.776, "o", "\u001b[90m 452\u001b[0m\u001b[90m │ \u001b[0m}\u001b[90m\u001b[39;49;00m\n"]
